@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost REQUIRED)
set(GFLAGS_USE_TARGET_NAMESPACE TRUE)
find_dependency(glog CONFIG REQUIRED)
find_dependency(gflags CONFIG REQUIRED)
find_dependency(folly CONFIG REQUIRED)
find_dependency(Protobuf CONFIG REQUIRED)
find_dependency(absl CONFIG REQUIRED)
find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(Torch REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/XLLMNativeTargets.cmake")

# Device headers remain provided by the matching vendor SDK and Torch build.
# Resolve them at the consuming installation, never from host build-tree paths.
if(@USE_NPU@)
  find_path(XLLMNative_CANN_INCLUDE_DIR acl/acl.h
    HINTS ENV NPU_HOME_PATH ENV ASCEND_HOME_PATH
    PATH_SUFFIXES include REQUIRED)
  find_path(XLLMNative_ATB_INCLUDE_DIR atb/atb_infer.h
    HINTS ENV ATB_HOME_PATH PATH_SUFFIXES include REQUIRED)
  find_path(XLLMNative_TORCH_NPU_INCLUDE_DIR torch_npu/torch_npu.h
    HINTS ENV PYTORCH_NPU_INSTALL_PATH PATH_SUFFIXES include REQUIRED)
  set_property(TARGET XLLM::native_extension APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES
      "${XLLMNative_CANN_INCLUDE_DIR}"
      "${XLLMNative_ATB_INCLUDE_DIR}"
      "${XLLMNative_TORCH_NPU_INCLUDE_DIR}")
endif()
if(@USE_MLU@)
  find_path(XLLMNative_NEUWARE_INCLUDE_DIR cn_api.h
    HINTS ENV NEUWARE_HOME PATH_SUFFIXES include REQUIRED)
  find_path(XLLMNative_TORCH_MLU_INCLUDE_DIR framework/core/MLUStream.h
    HINTS ENV PYTORCH_MLU_INSTALL_PATH PATH_SUFFIXES csrc REQUIRED)
  get_filename_component(_xllm_native_torch_mlu_root
    "${XLLMNative_TORCH_MLU_INCLUDE_DIR}" DIRECTORY)
  set_property(TARGET XLLM::native_extension APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES
      "${XLLMNative_NEUWARE_INCLUDE_DIR}"
      "${XLLMNative_TORCH_MLU_INCLUDE_DIR}")
  foreach(_include_dir
      "${_xllm_native_torch_mlu_root}"
      "${_xllm_native_torch_mlu_root}/.."
      "${XLLMNative_TORCH_MLU_INCLUDE_DIR}/include")
    if(IS_DIRECTORY "${_include_dir}")
      set_property(TARGET XLLM::native_extension APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${_include_dir}")
    endif()
  endforeach()
endif()
if(@USE_MUSA@)
  find_dependency(TorchMusa CONFIG REQUIRED
    HINTS "$ENV{TORCH_MUSA_PYTHONPATH}")
  # Use the package directory selected by find_dependency.  An explicit
  # TorchMusa_DIR must take precedence over the discovery hint in
  # TORCH_MUSA_PYTHONPATH, otherwise headers from two installations can mix.
  get_filename_component(_xllm_native_torch_musa_root
    "${TorchMusa_DIR}/../../.." ABSOLUTE)
  find_path(XLLMNative_MUSA_INCLUDE_DIR musa.h
    HINTS ENV MUSA_HOME ENV MUSA_PATH
    PATHS /usr/local/musa PATH_SUFFIXES include REQUIRED)
  find_path(XLLMNative_TORCH_MUSA_INCLUDE_DIR c10/musa/MUSAGuard.h
    HINTS ${TorchMusa_INCLUDE_DIRS}
      "${_xllm_native_torch_musa_root}/share/generated_cuda_compatible/include"
    REQUIRED)
  set_property(TARGET XLLM::native_extension APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES
      "${XLLMNative_MUSA_INCLUDE_DIR}"
      "${XLLMNative_TORCH_MUSA_INCLUDE_DIR}"
      ${TorchMusa_INCLUDE_DIRS})
  foreach(_include_dir
      "${_xllm_native_torch_musa_root}/share/torch_musa_codegen"
      "${_xllm_native_torch_musa_root}/share/generated_cuda_compatible/include"
      "${_xllm_native_torch_musa_root}/share/generated_cuda_compatible/include/torch/csrc/api/include"
      "${_xllm_native_torch_musa_root}/share/generated_cuda_compatible/include/torch/csrc/musa")
    if(IS_DIRECTORY "${_include_dir}")
      set_property(TARGET XLLM::native_extension APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${_include_dir}")
    endif()
  endforeach()
endif()

check_required_components(XLLMNative)
